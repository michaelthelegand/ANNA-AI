# ANNA-AI environment example (DO NOT put real secrets here)

ANNA_AI_NAME=ANNA
LOG_LEVEL=INFO

# Feature flags (0/1)
ANNA_TTS_ENABLE=0
ANNA_TERMINAL_ENABLE=0
ANNA_BROWSER_ENABLE=0
ANNA_WINDOWS_CONTROL_ENABLE=0
ANNA_MOUSE_ENABLE=0
ANNA_KEYBOARD_ENABLE=0
ANNA_STT_ENABLE=0

# Optional: pick mic device (index from 'mics' command). Leave empty for system default.
ANNA_STT_DEVICE_INDEX=

# Future (placeholders only):
# OPENAI_API_KEY=your_key_here
# PROVIDER=openai

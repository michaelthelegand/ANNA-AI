# ANNA-AI environment example (DO NOT put real secrets here)
# Copy to .env later (we will keep .env out of git)

ANNA_AI_NAME=ANNA
LOG_LEVEL=INFO

# Feature flags (0/1)
ANNA_TTS_ENABLE=0
ANNA_TERMINAL_ENABLE=0
ANNA_BROWSER_ENABLE=0

